---
import Layout from '../layouts/Layout.astro';
import noticias from '../data/noticias.json';

const todas = [...noticias].sort((a, b) => new Date(b.data).getTime() - new Date(a.data).getTime());

const principal   = todas[0];
const secundarias = todas.slice(1, 4);
const recentes    = todas.slice(4, 20);

const categorias = [
  { nome: 'Constitucional', hex: '#7c3aed' },
  { nome: 'Trabalhista',    hex: '#ea580c' },
  { nome: 'Tributário',     hex: '#059669' },
  { nome: 'Civil',          hex: '#2563eb' },
  { nome: 'Penal',          hex: '#dc2626' },
  { nome: 'Previdenciário', hex: '#0d9488' },
];

const coresCat: Record<string, string> = {
  Constitucional: '#7c3aed',
  Trabalhista:    '#ea580c',
  Tributário:     '#059669',
  Civil:          '#2563eb',
  Penal:          '#dc2626',
  Previdenciário: '#0d9488',
  Geral:          '#64748b',
};

function catSlug(cat: string) {
  return cat.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
}

function tempo(iso: string) {
  const diff = Date.now() - new Date(iso).getTime();
  const h = Math.floor(diff / 3.6e6);
  const d = Math.floor(h / 24);
  if (h < 1)  return 'agora';
  if (h < 24) return `há ${h}h`;
  if (d === 1) return 'ontem';
  return `há ${d} dias`;
}

function noticias_cat(cat: string, limit = 4) {
  return todas.filter(n => n.categoria === cat).slice(0, limit);
}

const vazio = todas.length === 0;
---

<Layout
  title="Notícia Jurídica"
  description={`Notícias jurídicas do Brasil atualizadas: STJ, STF, TST, legislação e jurisprudência. ${todas.length} notícias publicadas.`}
>

{vazio && (
  <p class="text-center py-24 text-gray-400 text-lg">Aguardando primeiro scraping...</p>
)}

{!vazio && (
<div class="space-y-10">

  <!-- ═══════════════════════════════════════════
       DESTAQUE PRINCIPAL
  ═══════════════════════════════════════════ -->
  <section class="grid grid-cols-1 md:grid-cols-3 border border-gray-200 rounded-xl overflow-hidden">
    <!-- Artigo principal -->
    <div class="md:col-span-2 relative min-h-72">
      {principal.imagem
        ? <img src={principal.imagem} alt={principal.titulo}
            class="w-full h-72 md:h-full object-cover" loading="eager" />
        : <div class="w-full h-72 md:h-full bg-blue-950"></div>
      }
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-5 md:p-8">
        <span class="inline-block text-white text-xs font-bold uppercase tracking-widest px-2.5 py-1 rounded mb-3"
          style={`background-color:${coresCat[principal.categoria] ?? '#64748b'}`}>
          {principal.categoria}
        </span>
        <a href={`/noticias/${principal.id}`}>
          <h2 class="text-white font-black text-xl md:text-2xl leading-tight hover:text-red-300 transition-colors mb-2"
            style="font-family:'Playfair Display',serif;text-shadow:0 1px 6px rgba(0,0,0,.6)">
            {principal.titulo}
          </h2>
        </a>
        <p class="text-gray-300 text-xs">{principal.fonte} · {tempo(principal.data)}</p>
      </div>
    </div>

    <!-- Sidebar — 3 artigos -->
    <div class="divide-y divide-gray-100 border-t md:border-t-0 md:border-l border-gray-200">
      {secundarias.map(n => (
        <div class="p-4 hover:bg-gray-50 transition-colors">
          <span class="text-xs font-bold uppercase tracking-wide block mb-1"
            style={`color:${coresCat[n.categoria] ?? '#64748b'}`}>
            {n.categoria}
          </span>
          <a href={`/noticias/${n.id}`}>
            <h3 class="font-bold text-gray-900 text-sm leading-snug hover:text-red-700 transition-colors line-clamp-3">
              {n.titulo}
            </h3>
          </a>
          <p class="text-xs text-gray-400 mt-2">{n.fonte} · {tempo(n.data)}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ÚLTIMAS NOTÍCIAS — grade compacta
  ═══════════════════════════════════════════ -->
  <section>
    <div class="flex items-center gap-3 mb-5">
      <span class="block w-1 h-5 bg-red-600 rounded-full"></span>
      <h2 class="font-black text-gray-900 text-sm uppercase tracking-widest">Últimas notícias</h2>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-6">
      {recentes.map(n => (
        <article class="group">
          {n.imagem && (
            <img src={n.imagem} alt={n.titulo}
              class="w-full h-28 object-cover rounded-lg mb-2.5" loading="lazy" />
          )}
          <span class="text-xs font-bold uppercase tracking-wide block mb-1"
            style={`color:${coresCat[n.categoria] ?? '#64748b'}`}>
            {n.categoria}
          </span>
          <a href={`/noticias/${n.id}`}>
            <h3 class="font-semibold text-gray-900 text-sm leading-snug group-hover:text-red-700 transition-colors line-clamp-3">
              {n.titulo}
            </h3>
          </a>
          <p class="text-xs text-gray-400 mt-1.5">{n.fonte} · {tempo(n.data)}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SEÇÕES POR CATEGORIA
  ═══════════════════════════════════════════ -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {categorias.map(cat => {
      const itens = noticias_cat(cat.nome);
      if (itens.length < 2) return null;
      const sl = catSlug(cat.nome);
      return (
        <section>
          <div class="flex items-center justify-between mb-4 pb-2.5 border-b-2"
            style={`border-color:${cat.hex}`}>
            <h2 class="font-black text-sm uppercase tracking-widest"
              style={`color:${cat.hex}`}>
              {cat.nome}
            </h2>
            <a href={`/categoria/${sl}`} class="text-xs text-gray-400 hover:text-gray-700 transition-colors">
              Ver mais →
            </a>
          </div>
          <div class="space-y-3">
            {itens.map((n, idx) => (
              <div class={`flex gap-3 pb-3${idx < itens.length - 1 ? ' border-b border-gray-100' : ''}`}>
                {n.imagem && (
                  <img src={n.imagem} alt={n.titulo}
                    class="w-16 h-16 object-cover rounded flex-shrink-0" loading="lazy" />
                )}
                <div class="flex-1 min-w-0">
                  <a href={`/noticias/${n.id}`}>
                    <h3 class="font-semibold text-gray-900 text-sm leading-snug hover:text-red-700 transition-colors line-clamp-2">
                      {n.titulo}
                    </h3>
                  </a>
                  <p class="text-xs text-gray-400 mt-1">{n.fonte} · {tempo(n.data)}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      );
    })}
  </div>

</div>
)}

</Layout>
