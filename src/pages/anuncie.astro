---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Anuncie no Notícia Jurídica — Alcance Advogados e Operadores do Direito"
  description="Anuncie no portal de notícias jurídicas mais atualizado do Brasil. Alcance advogados, juízes, promotores e gestores jurídicos. Formatos de banner, native e sponsored post."
  breadcrumbs={[{ nome: 'Anuncie', url: '/anuncie' }]}
>

  <!-- ═══ HERO ═══════════════════════════════════════════ -->
  <section class="relative bg-blue-950 rounded-2xl overflow-hidden mb-16 px-8 md:px-16 py-16 md:py-20">
    <!-- Fundo decorativo -->
    <div class="absolute inset-0 opacity-5" style="background-image:repeating-linear-gradient(0deg,transparent,transparent 40px,#fff 40px,#fff 41px),repeating-linear-gradient(90deg,transparent,transparent 40px,#fff 40px,#fff 41px)"></div>
    <div class="relative max-w-3xl">
      <span class="inline-block text-red-400 text-xs font-black uppercase tracking-widest mb-5">Para anunciantes</span>
      <h1 class="text-white font-black text-4xl md:text-5xl leading-tight mb-6" style="font-family:'Playfair Display',serif">
        Fale com quem<br/>decide no direito.
      </h1>
      <p class="text-blue-200 text-lg leading-relaxed mb-8 max-w-xl">
        O Notícia Jurídica é o portal de notícias jurídicas mais atualizado do Brasil — com cobertura de STF, STJ, TST e legislação federal, atualizado 6 vezes ao dia.
        Nosso leitor é advogado, juiz, promotor ou gestor jurídico. Perfil de alta renda e alto poder de decisão.
      </p>
      <a
        href="https://wa.me/5518997985211?text=Olá!%20Quero%20anunciar%20no%20Notícia%20Jurídica"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-red-700 hover:bg-red-600 text-white font-bold px-8 py-3.5 rounded-lg transition-colors text-base"
      >
        Solicitar proposta →
      </a>
    </div>
  </section>

  <!-- ═══ NÚMEROS ══════════════════════════════════════════ -->
  <section class="mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 rounded-xl overflow-hidden">
      {[
        { num: '120.000+', label: 'Visitas por mês' },
        { num: '500+',     label: 'Artigos publicados' },
        { num: '6×',       label: 'Atualizado por dia' },
        { num: '6',        label: 'Especialidades jurídicas' },
      ].map(({ num, label }) => (
        <div class="bg-white px-6 py-8 text-center">
          <div class="text-3xl md:text-4xl font-black text-blue-950 mb-1">{num}</div>
          <div class="text-xs text-gray-500 uppercase tracking-wide font-medium">{label}</div>
        </div>
      ))}
    </div>
    <p class="text-center text-xs text-gray-400 mt-3">Números em crescimento. Indexação ativa no Google News desde o lançamento.</p>
  </section>

  <!-- ═══ PERFIL DO LEITOR ══════════════════════════════════ -->
  <section class="mb-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div>
      <span class="block text-red-700 text-xs font-black uppercase tracking-widest mb-3">Audiência</span>
      <h2 class="text-2xl md:text-3xl font-black text-blue-950 leading-tight mb-6" style="font-family:'Playfair Display',serif">
        Um leitor que decide,<br/>compra e recomenda.
      </h2>
      <p class="text-gray-600 leading-relaxed">
        A audiência do Notícia Jurídica é formada por profissionais do direito — o segmento com maior concentração de renda e poder de decisão de compra do país.
      </p>
    </div>
    <div class="space-y-3">
      {[
        'Advogados e estagiários de direito',
        'Juízes, promotores e delegados',
        'Estudantes de direito e pós-graduação',
        'Gestores e departamentos jurídicos',
        'Renda média acima de R$ 5.000',
        'Alta intenção de compra em serviços e ferramentas jurídicas',
      ].map(item => (
        <div class="flex items-start gap-3">
          <span class="mt-0.5 w-4 h-4 rounded-full bg-red-700 shrink-0 flex items-center justify-center">
            <svg width="8" height="6" viewBox="0 0 8 6" fill="none"><path d="M1 3l2 2 4-4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="text-gray-700 text-sm">{item}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ FORMATOS ══════════════════════════════════════════ -->
  <section class="mb-16">
    <div class="mb-8">
      <span class="block text-red-700 text-xs font-black uppercase tracking-widest mb-3">Formatos</span>
      <h2 class="text-2xl font-black text-blue-950" style="font-family:'Playfair Display',serif">Escolha como aparecer.</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        {
          nome: 'Banner Header',
          desc: 'Exibido logo abaixo do ticker de notícias. Visibilidade máxima em todas as páginas do portal.',
          ideal: 'Cursos OAB, legaltech, editoras jurídicas',
          destaque: false,
        },
        {
          nome: 'Sponsored Post',
          desc: 'Artigo patrocinado integrado ao feed editorial. Formato nativo, alta taxa de leitura e engajamento.',
          ideal: 'Escritórios, serviços B2B, consultorias',
          destaque: true,
        },
        {
          nome: 'Sidebar Sticky',
          desc: 'Banner lateral fixo que acompanha o leitor durante a leitura completa do artigo.',
          ideal: 'Seguradoras, bancos, fintechs jurídicas',
          destaque: false,
        },
      ].map(f => (
        <div class:list={[
          'rounded-xl p-7 border flex flex-col',
          f.destaque ? 'border-red-700 bg-blue-950 text-white' : 'border-gray-200 bg-white'
        ]}>
          {f.destaque && (
            <span class="text-xs bg-red-700 text-white font-black px-2.5 py-1 rounded uppercase tracking-widest mb-4 self-start">
              Mais popular
            </span>
          )}
          <h3 class:list={['font-black text-lg mb-3', f.destaque ? 'text-white' : 'text-blue-950']}>{f.nome}</h3>
          <p class:list={['text-sm leading-relaxed mb-4 flex-1', f.destaque ? 'text-blue-200' : 'text-gray-500']}>{f.desc}</p>
          <div class:list={['text-xs mb-5', f.destaque ? 'text-blue-300' : 'text-gray-400']}>
            <span class="font-semibold">Ideal para:</span> {f.ideal}
          </div>
          <a
            href="https://wa.me/5518997985211?text=Quero%20saber%20mais%20sobre%20o%20formato%20{f.nome}%20no%20Notícia%20Jurídica"
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'text-sm font-bold text-center py-2.5 rounded-lg transition-colors border-t pt-4 mt-auto',
              f.destaque ? 'text-red-400 border-blue-800 hover:text-red-300' : 'text-red-700 border-gray-100 hover:text-red-600'
            ]}
          >
            Solicitar proposta →
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ SEGMENTOS ════════════════════════════════════════ -->
  <section class="mb-16">
    <h2 class="text-sm font-black text-gray-400 uppercase tracking-[.15em] mb-5">Segmentos que anunciam aqui</h2>
    <div class="flex flex-wrap gap-2">
      {[
        'Cursos preparatórios OAB',
        'Pós-graduação em Direito',
        'Software de gestão jurídica',
        'Escritórios de advocacia',
        'Editoras jurídicas',
        'Seguros profissionais',
        'Plataformas de petições com IA',
        'Consultorias tributárias',
        'Bancos e fintechs',
        'Eventos jurídicos',
      ].map(item => (
        <span class="border border-gray-200 text-gray-600 text-sm px-4 py-1.5 rounded-full">{item}</span>
      ))}
    </div>
  </section>

  <!-- ═══ CTA FINAL ═════════════════════════════════════════ -->
  <section class="bg-blue-950 rounded-2xl px-8 md:px-16 py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-8">
    <div>
      <h2 class="text-white font-black text-2xl md:text-3xl leading-tight mb-3" style="font-family:'Playfair Display',serif">
        Pronto para alcançar<br/>operadores do direito?
      </h2>
      <p class="text-blue-300 text-sm">Receba um kit de mídia com formatos, preços e métricas. Respondemos em até 24h.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 shrink-0">
      <a
        href="https://wa.me/5518997985211?text=Quero%20anunciar%20no%20Notícia%20Jurídica"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-green-500 hover:bg-green-400 text-white font-bold px-7 py-3 rounded-lg transition-colors text-sm whitespace-nowrap"
      >
        WhatsApp
      </a>
      <a
        href="mailto:contato@noticiajuridicas.com.br"
        class="bg-white hover:bg-gray-100 text-blue-950 font-bold px-7 py-3 rounded-lg transition-colors text-sm whitespace-nowrap"
      >
        Enviar e-mail
      </a>
    </div>
  </section>

</Layout>
