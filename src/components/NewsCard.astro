---
interface Props {
  noticia: {
    id: string;
    titulo: string;
    resumo: string;
    link: string;
    fonte: string;
    categoria: string;
    data: string;
    imagem?: string;
  };
  destaque?: boolean;
}

const { noticia, destaque = false } = Astro.props;

const coresCategoria: Record<string, string> = {
  Constitucional: 'bg-purple-100 text-purple-800',
  Trabalhista:    'bg-orange-100 text-orange-800',
  Tributário:     'bg-green-100 text-green-800',
  Civil:          'bg-blue-100 text-blue-800',
  Penal:          'bg-red-100 text-red-800',
  Previdenciário: 'bg-teal-100 text-teal-800',
  Geral:          'bg-gray-100 text-gray-700',
};

const cor = coresCategoria[noticia.categoria] ?? coresCategoria['Geral'];

function tempo(iso: string) {
  const diff = Date.now() - new Date(iso).getTime();
  const h = Math.floor(diff / 3.6e6);
  const d = Math.floor(h / 24);
  if (h < 1) return 'agora';
  if (h < 24) return `há ${h}h`;
  if (d === 1) return 'ontem';
  return `há ${d} dias`;
}
---
<article class:list={['news-card flex flex-col', destaque ? 'md:flex-row' : '']}>
  {noticia.imagem && (
    <div class:list={['bg-gray-200 overflow-hidden', destaque ? 'md:w-64 md:flex-shrink-0' : 'h-44']}>
      <img
        src={noticia.imagem}
        alt={noticia.titulo}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
  )}
  {!noticia.imagem && destaque && (
    <div class="md:w-64 md:flex-shrink-0 h-44 md:h-auto bg-blue-50 flex items-center justify-center">
      <svg class="w-16 h-16 text-blue-200" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
      </svg>
    </div>
  )}
  <div class="p-4 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-2">
      <span class:list={['category-badge', cor]}>{noticia.categoria}</span>
      <span class="text-xs text-gray-400">{noticia.fonte}</span>
      <span class="text-xs text-gray-400 ml-auto">{tempo(noticia.data)}</span>
    </div>
    <a href={`/noticias/${noticia.id}`} class="group">
      <h2 class:list={['font-bold text-gray-900 group-hover:text-blue-800 transition-colors leading-snug mb-2',
        destaque ? 'text-xl' : 'text-base']}
      >
        {noticia.titulo}
      </h2>
    </a>
    <p class="text-sm text-gray-600 leading-relaxed line-clamp-3 flex-1">
      {noticia.resumo}
    </p>
    <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between">
      <a
        href={`/noticias/${noticia.id}`}
        class="text-sm text-blue-700 font-medium hover:underline"
      >
        Ler mais →
      </a>
      <time class="text-xs text-gray-400" datetime={noticia.data}>
        {new Date(noticia.data).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })}
      </time>
    </div>
  </div>
</article>
