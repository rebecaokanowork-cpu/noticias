---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
  breadcrumbs?: Array<{ nome: string; url: string }>;
}

const SITE_NAME = 'Notícia Jurídica';
const SITE_URL  = 'https://noticiajuridicas.com.br';

const {
  title,
  description = 'Notícias jurídicas atualizadas do Brasil: decisões do STJ, STF, TST, legislação, jurisprudência e análises. Atualizado diariamente.',
  image = `${SITE_URL}/og-default.svg`,
  canonical = Astro.url.href,
  type = 'website',
  breadcrumbs = [],
} = Astro.props;

const fullTitle = title === SITE_NAME
  ? `${SITE_NAME} — Notícias Jurídicas do Brasil`
  : `${title} | ${SITE_NAME}`;

// Schema: Organization
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE_NAME,
  "url": SITE_URL,
  "logo": { "@type": "ImageObject", "url": `${SITE_URL}/favicon.svg` },
  "description": "Agregador de notícias jurídicas brasileiras — STJ, STF, TST, Conjur, JOTA.",
  "sameAs": [],
};

// Schema: WebSite com SearchAction
const schemaWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": SITE_URL,
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": `${SITE_URL}/busca?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};

// Schema: BreadcrumbList
const schemaBreadcrumb = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": SITE_URL },
    ...breadcrumbs.map((bc, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": bc.nome,
      "item": `${SITE_URL}${bc.url}`,
    })),
  ],
} : null;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:url" content={canonical} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google AdSense — substitua pelo seu publisher ID -->
  <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-N696PZDM');</script>

  <!-- Google Analytics GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-3C9E37W6PS"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-3C9E37W6PS');
  </script>

  <!-- Schema.org: Organization + WebSite (todas as páginas) -->
  <script type="application/ld+json" set:text={JSON.stringify(schemaOrg)} />
  <script type="application/ld+json" set:text={JSON.stringify(schemaWebsite)} />
  {schemaBreadcrumb && (
    <script type="application/ld+json" set:text={JSON.stringify(schemaBreadcrumb)} />
  )}
</head>
<body class="bg-gray-50">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N696PZDM"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <Header />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <slot />
  </main>
  <Footer />
</body>
</html>
